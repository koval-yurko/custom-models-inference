{
  "permissions": {
    "allow": [
      "Bash(direnv exec * terraform apply *)",
      "Bash(direnv exec * terraform destroy *)",
      "Bash(terraform -chdir=* apply *)",
      "Bash(terraform -chdir=* destroy *)"
    ]
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "pstack@cursor-plugins": true
  },
  "extraKnownMarketplaces": {
    "cursor-plugins": {
      "source": {
        "source": "github",
        "repo": "cursor/plugins",
        "sparsePaths": [
          ".claude-plugin",
          "harness/pstack"
        ]
      }
    }
  }
}
