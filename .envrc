# direnv loads .env into the shell when you enter this folder.
dotenv_if_exists .env
# One place for project values: .env -> Terraform variables and gcloud defaults.
tf_var() { [ -n "${2:-}" ] && export "TF_VAR_$1=$2"; return 0; }
tf_var project_id "${GCP_PROJECT_ID:-}"
tf_var region "${GCP_REGION:-}"
tf_var billing_account "${BILLING_ACCOUNT:-}"
tf_var invoker_email "${INVOKER_EMAIL:-}"
tf_var budget_amount "${BUDGET_AMOUNT:-}"
[ -n "${GCP_PROJECT_ID:-}" ] && export CLOUDSDK_CORE_PROJECT="$GCP_PROJECT_ID"
[ -n "${GCP_REGION:-}" ] && export CLOUDSDK_RUN_REGION="$GCP_REGION"
# Terraform reads TF_VAR_hf_token (infra/core creates the hf-token secret version from it).
export TF_VAR_hf_token="${HF_TOKEN:-}"
# Terraform reads TF_VAR_runpod_api_key (infra/core creates the runpod-api-key secret version from it).
export TF_VAR_runpod_api_key="${RUNPOD_API_KEY:-}"
# infra/core creates the modal-api-key secret version from the Modal proxy token: <id>.<secret> (the Bearer form).
export TF_VAR_modal_api_key="${MODAL_PROXY_TOKEN_ID:+${MODAL_PROXY_TOKEN_ID}.${MODAL_PROXY_TOKEN_SECRET:-}}"
# infra/core writes the Runpod S3 API key to 2 secrets (scripts/runpod-weights.py --cloud reads them).
export TF_VAR_runpod_s3_access_key="${RUNPOD_S3_ACCESS_KEY:-}"
export TF_VAR_runpod_s3_secret_key="${RUNPOD_S3_SECRET_KEY:-}"
# Terraform reads TF_VAR_slack_bot_token and TF_VAR_slack_channel (infra/core creates the Slack notification channel).
export TF_VAR_slack_bot_token="${SLACK_BOT_TOKEN:-}"
tf_var slack_channel "${SLACK_CHANNEL:-}"
# gcloud ignores GOOGLE_APPLICATION_CREDENTIALS. Point it at the same key, and use a project-local
# config dir so gcloud never uses the global login or global config.
if [ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]; then
  export CLOUDSDK_AUTH_CREDENTIAL_FILE_OVERRIDE="$GOOGLE_APPLICATION_CREDENTIALS"
  export CLOUDSDK_CONFIG="$PWD/.gcloud"
fi
