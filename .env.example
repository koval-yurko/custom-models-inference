# Copy to .env (git-ignored) and fill in. Terraform and gcloud do not read .env by themselves.
# direnv loads it for you (see .envrc): run `direnv allow` once.
# Without direnv: set -a; source .env; set +a

# HCP Terraform
TF_CLOUD_ORGANIZATION=
TF_CLOUD_PROJECT=custom-models-inference   # new workspaces go into this HCP project
TF_TOKEN_app_terraform_io=                 # API token (User settings > Tokens); replaces `terraform login`

# GCP. If empty, Terraform falls back to your global ADC login and gcloud to your global account.
GOOGLE_APPLICATION_CREDENTIALS=            # absolute path to a service account key JSON; Terraform AND gcloud use it (.envrc maps it for gcloud)

# Hugging Face (bootstrap writes it to the Secret Manager secret hf-token)
HF_TOKEN=

# Project values (non-secret). .envrc maps them to TF_VAR_* and to the gcloud defaults.
GCP_PROJECT_ID=custom-models-inference     # -> var.project_id, gcloud project
GCP_REGION=europe-west4                    # -> var.region, gcloud run region (optional)
BILLING_ACCOUNT=                           # -> var.billing_account (bootstrap). Find it: gcloud billing accounts list
INVOKER_EMAIL=                             # -> var.invoker_email: the Google account that may call the services
BUDGET_AMOUNT=                             # -> var.budget_amount, whole number (optional, default 20)
