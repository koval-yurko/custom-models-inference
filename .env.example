# Copy to .env (git-ignored) and fill in. Terraform and gcloud do not read .env by themselves.
# direnv loads it for you (see .envrc): run `direnv allow` once.
# Without direnv: set -a; source .env; set +a
# After every change: ./scripts/hcp-sync.py   (copies the values to the HCP workspaces)

# HCP Terraform
TF_CLOUD_ORGANIZATION=
TF_CLOUD_PROJECT=custom-models-inference   # new workspaces go into this HCP project
TF_TOKEN_app_terraform_io=                 # API token (User settings > Tokens); replaces `terraform login`

# GCP. Remote runs get the key from HCP: run ./scripts/hcp-sync.py after you change this file.
GOOGLE_APPLICATION_CREDENTIALS=            # absolute path to a service account key JSON; synced to HCP as GOOGLE_CREDENTIALS; local gcloud uses it too (.envrc)

# Hugging Face (infra/core writes it to the Secret Manager secret hf-token)
HF_TOKEN=

# Slack (infra/core: scale notifications, see infra/README.md)
SLACK_BOT_TOKEN=                           # Bot User OAuth Token (xoxb-...), scope chat:write
SLACK_CHANNEL="#models"                    # quotes needed: without them, direnv reads # as a comment

# Runpod: console, Settings, API Keys. infra/core writes it to the secret runpod-api-key (the CORS proxies read it).
# hcp-sync.py gives it to every HCP workspace (the runpod provider needs it).
RUNPOD_API_KEY=
# Runpod S3 API key: console, Settings, S3 API keys (not the API key above). Only scripts/runpod-weights.py uses it
# (it copies weights to a Runpod network volume). Not in HCP or Terraform.
RUNPOD_S3_ACCESS_KEY=                      # user_...
RUNPOD_S3_SECRET_KEY=                      # rps_... (shown once)
# Modal: `uvx modal token new` (or the dashboard, Settings, API Tokens). scripts/platforms/modal.py runs the modal CLI with them.
MODAL_TOKEN_ID=                            # ak-...
MODAL_TOKEN_SECRET=                        # as-...
MODAL_PROFILE=                             # the Modal workspace name; the web URL is https://<workspace>--<app>.modal.run
# Modal proxy token: `uvx modal workspace proxy-tokens create --name cors-proxy` (or the dashboard). .envrc and
# hcp-sync.py join them to <id>.<secret>; infra/core writes that to the secret modal-api-key (the CORS proxies read it).
MODAL_PROXY_TOKEN_ID=                      # wk-...
MODAL_PROXY_TOKEN_SECRET=                  # ws-...

# Project values (non-secret). .envrc maps them to TF_VAR_* and to the gcloud defaults.
GCP_PROJECT_ID=custom-models-inference     # -> var.project_id, gcloud project
GCP_REGION=us-central1                    # -> var.region, gcloud run region (optional)
BILLING_ACCOUNT=                           # -> var.billing_account (infra/core). Find it: gcloud billing accounts list
INVOKER_EMAIL=                             # -> var.invoker_email: the Google account that may call the services
BUDGET_AMOUNT=                             # -> var.budget_amount, whole number (optional, default 20)
